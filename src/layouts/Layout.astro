---
interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  showHero?: boolean;
  immersive?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}
const siteUrl = "https://herderrock.be";
const isProductionSite = import.meta.env.PROD && import.meta.env.MODE !== "testing";
const {
  title,
  description = "Herderrock is een cosy muziekfestival in Herdersem (Aalst) met rock, Belgische bands en lokaal talent sinds 1985.",
  canonicalPath = Astro.url.pathname,
  image = "/visuals/aftermovie-2026-desktop.webp",
  imageAlt = "Herderrock muziekfestival in Herdersem (Aalst)",
  immersive = false,
  jsonLd = [],
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const structuredData = [
  { "@context": "https://schema.org", "@type": "Organization", "@id": `${siteUrl}/#organization`, name: "VZW Herderrock", url: siteUrl, logo: `${siteUrl}/logo.png` },
  { "@context": "https://schema.org", "@type": "WebSite", "@id": `${siteUrl}/#website`, name: "Herderrock", url: `${siteUrl}/`, inLanguage: "nl-BE", publisher: { "@id": `${siteUrl}/#organization` } },
  ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]),
];
---
<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="zRxKiOJuqhGWPzImWd33iPDDDJ34F0CXX7pbbeO-lCM" />
    {isProductionSite && <>
      <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-9NPZN5CLXC"></script>
      <script is:inline>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-9NPZN5CLXC');</script>
    </>}
    <meta name="description" content={description} />
    <meta name="robots" content={isProductionSite ? "index, follow, max-image-preview:large, max-video-preview:-1" : "noindex, nofollow"} />
    <meta name="author" content="VZW Herderrock" />
    <meta name="theme-color" content={immersive ? "#11110e" : "#ed1c24"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/impact.ttf" as="font" type="font/ttf" crossorigin />
    <meta property="og:locale" content="nl_BE" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Herderrock" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {structuredData.map(data => <script is:inline type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>)}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class:list={{ immersive }}>
    <a class="skip-link" href="#main-content">Naar de inhoud</a>
    <header class="site-header">
      <a href="/" class="logo" aria-label="Herderrock, naar de homepage"><img src="/logo.webp" alt="Herderrock" width="834" height="834" fetchpriority="high" /></a>
      <div class="header-actions">
        <a href="https://shop.herderrock.be" class="merch-link" target="_blank" rel="noreferrer">MERCH <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a>
        <button class="menu-toggle" type="button" aria-label="Menu openen" aria-expanded="false" aria-controls="site-menu"><span class="menu-label">MENU</span><span class="menu-icon" aria-hidden="true"><i></i><i></i></span></button>
      </div>
      <nav class="site-menu" id="site-menu" aria-label="Hoofdnavigatie" hidden>
        <a href="/#aftermovie">Aftermovie</a><a href="/#about">Over Herderrock</a><a href="/#line-up">Line-up</a><a href="/sponsors/">Sponsors</a><a href="/affiches/">Affichearchief</a><a href="/faq/">Praktische info</a><a class="menu-merch" href="https://shop.herderrock.be" target="_blank" rel="noreferrer">Merch shop</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer"><a href="/" class="footer-name">HERDERROCK</a><span>A cosy festival since 1985.</span><div><a href="/faq/">Praktische info</a><a href="/sponsors/">Onze sponsors</a><a href="/affiches/">Het archief</a></div><small>© Herderrock 1985-2026 · Made by <a href="https://www.oddunit.be" target="_blank" rel="noreferrer">OddUnitStudio</a></small></footer>
    <script>
      const header = document.querySelector<HTMLElement>(".site-header")!;
      const menu = document.querySelector<HTMLElement>("#site-menu")!;
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle")!;
      const main = document.querySelector<HTMLElement>("main");
      const footer = document.querySelector<HTMLElement>(".site-footer");
      if (main && !main.id) main.id = "main-content";
      const setMenu = (open: boolean, restoreFocus = true) => {
        menu.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Menu sluiten" : "Menu openen");
        header.classList.toggle("menu-open", open);
        document.body.classList.toggle("menu-is-open", open);
        if (main) main.inert = open;
        if (footer) footer.inert = open;
        if (open) menu.querySelector<HTMLAnchorElement>("a")?.focus();
        else if (restoreFocus) toggle.focus();
      };
      toggle.addEventListener("click", () => setMenu(menu.hidden));
      menu.querySelectorAll("a").forEach(link => link.addEventListener("click", () => setMenu(false, false)));
      document.addEventListener("keydown", (event) => {
        if (menu.hidden) return;
        if (event.key === "Escape") setMenu(false);
        if (event.key === "Tab") {
          const links = Array.from(header.querySelectorAll<HTMLElement>("a, button")).filter(el => el.getClientRects().length);
          const first = links[0]; const last = links[links.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        }
      });
      const updateHeader = () => {
        header.classList.toggle("red-header", window.scrollY >= window.innerHeight * .225);
      };
      window.addEventListener("scroll", updateHeader, { passive: true });
      updateHeader();
    </script>
  </body>
</html>
<style is:global>
  @font-face { font-family: "Herderrock Impact"; src: url("/fonts/impact.ttf") format("truetype"); font-weight: 400; font-style: normal; font-display: swap; }
  :root { --red: #ed1c24; --white: #f9eed5; --primary-gray: #19203b; --black: #11110e; --display-font: "Herderrock Impact", Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif; }
  * { box-sizing: border-box; }
  html { font-family: Arial, sans-serif; background: var(--white); scroll-behavior: smooth; scroll-padding-top: 120px; scrollbar-color: var(--red) var(--black); }
  body { margin: 0; color: var(--primary-gray); background: var(--white); }
  body.immersive { background: var(--red); }
  body.menu-is-open { overflow: hidden; }
  h1, h2, h3, h4, h5, p { margin: 0; }
  h3 { font-family: var(--display-font); }
  a { color: inherit; text-decoration: none; text-underline-offset: .2em; }
  button { font: inherit; }
  strong { font-weight: bolder; color: var(--red); }
  [hidden] { display: none !important; }
  :focus-visible { outline: 3px solid currentColor; outline-offset: 5px; }
  ::selection { background: var(--primary-gray); color: var(--white); }
  .padding-y { padding-top: 3%; padding-bottom: 3%; }
  .padding-top { padding-top: 3%; }
  .padding-bottom { padding-bottom: 3%; }
  .padding-x { padding-left: 5%; padding-right: 5%; }
  .margin-top { margin-top: 3%; }
  .margin-bottom { margin-bottom: 3%; }
  .title-left { padding: 16px; background: var(--red); color: var(--white); text-align: right; }
  .title-right { padding: 16px; background: var(--primary-gray); color: var(--white); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .skip-link { position: fixed; top: 12px; left: 12px; padding: 14px; background: var(--white); color: var(--black); z-index: 2000; transform: translateY(-160%); }
  .skip-link:focus { transform: translateY(0); }
  .site-header { position: relative; height: 128px; display: flex; justify-content: flex-end; align-items: center; padding: 0 3.5vw; background: var(--red); color: var(--white); z-index: 100; }
  .immersive .site-header { position: fixed; top: 0; left: 0; right: 0; background: linear-gradient(to bottom, #11110ee6, #11110e00); }
  body:not(.immersive) .site-header, .immersive .site-header.red-header { color: #000; background: var(--red); }
  .site-header.menu-open { color: var(--white) !important; }
  .logo { position: absolute; top: -10px; left: 50%; transform: translateX(-50%); width: 146px; height: 146px; z-index: 2; }
  .logo img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .header-actions { display: flex; align-items: center; gap: 32px; z-index: 2; }
  .merch-link { display: flex; align-items: center; gap: 10px; min-height: 44px; font-size: .7rem; font-weight: 700; letter-spacing: .07em; }
  .merch-link svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.5; }
  .menu-toggle { color: inherit; border: 0; background: transparent; padding: 10px 0 10px 10px; cursor: pointer; display: flex; gap: 16px; align-items: center; min-width: 44px; min-height: 44px; }
  .menu-label { font-size: .7rem; font-weight: 700; letter-spacing: .07em; }
  .menu-icon { display: grid; gap: 6px; width: 25px; }
  .menu-icon i { display: block; height: 2px; width: 25px; background: currentColor; transition: transform .2s ease; }
  .menu-open .menu-icon i:first-child { transform: translateY(4px) rotate(45deg); }
  .menu-open .menu-icon i:last-child { transform: translateY(-4px) rotate(-45deg); }
  .site-menu { position: fixed; inset: 0; padding: 140px 24px 30px; background: var(--primary-gray); color: var(--white); display: flex; flex-direction: column; justify-content: center; align-items: center; overflow-y: auto; }
  .site-menu a { font-family: var(--display-font); text-transform: uppercase; font-size: clamp(1.6rem, 4.7vh, 3rem); padding: 8px 12px; text-align: center; }
  .site-menu a:hover { color: var(--red); }
  .site-menu .menu-merch { margin-top: 12px; font: 700 .85rem Arial, sans-serif; text-decoration: underline; min-height: 44px; }
  .site-footer { background: var(--black); color: var(--white); padding: 55px 6vw 30px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 22px; }
  .footer-name { font-family: var(--display-font); font-size: 2.2rem; }
  .site-footer > span { font-size: .85rem; }
  .site-footer > div { margin-left: auto; display: flex; gap: 24px; flex-wrap: wrap; }
  .site-footer > div a { font-size: .8rem; padding: 12px 0; }
  .site-footer a:hover { text-decoration: underline; }
  .site-footer small { flex-basis: 100%; font-size: .65rem; border-top: 1px solid #f9eed544; padding-top: 24px; margin-top: 10px; }
  @media (max-width: 767px) {
    .site-header { height: 112px; padding: 0 22px; }
    .logo { width: 134px; height: 134px; top: -12px; }
    .header-actions { gap: 0; }
    .merch-link, .menu-label { display: none; }
    .site-menu { padding-top: 120px; }
    .site-footer { padding: 38px 24px 26px; gap: 14px; }
    .site-footer > div { margin: 4px 0 0; flex-basis: 100%; gap: 20px; }
  }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .menu-icon i { transition: none; } }
</style>
