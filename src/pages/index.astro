---
import Layout from "../layouts/Layout.astro";
import VIPSponsors from "../components/VIPSponsors.astro";
const description = "Herderrock op zaterdag 4 september 2027: een cosy muziekfestival in Herdersem (Aalst). Herbeleef 2026 met de aftermovie. Nieuwe line-up: coming soon.";
const pageJsonLd = {
  "@context": "https://schema.org", "@type": "WebPage", "@id": "https://herderrock.be/#webpage",
  name: "Herderrock 2027: muziekfestival in Herdersem op 4 september", description, url: "https://herderrock.be/", inLanguage: "nl-BE",
  about: [{ "@id": "https://herderrock.be/#organization" }, { "@id": "https://herderrock.be/#herderrock-2027" }],
  isPartOf: { "@id": "https://herderrock.be/#website" },
  mainEntity: {
    "@type": "VideoObject", name: "Herderrock 2026: officiële aftermovie",
    description: "Sfeerbeelden van Herderrock op 5 september 2026 in Herdersem (Aalst), gemaakt door @emvlstudio.",
    thumbnailUrl: "https://herderrock.be/visuals/aftermovie-2026-desktop.webp",
    contentUrl: "https://herderrock.be/videos/2026/aftermovie-desktop-cut.webm", duration: "PT43.88S",
    creator: { "@type": "Organization", name: "@emvlstudio", url: "https://www.instagram.com/emvlstudio/" },
  },
};
const nextEditionJsonLd = {
  "@context": "https://schema.org", "@type": "MusicEvent", "@id": "https://herderrock.be/#herderrock-2027",
  name: "Herderrock 2027", startDate: "2027-09-04", url: "https://herderrock.be/",
  description: "Herderrock op zaterdag 4 september 2027 in Herdersem (Aalst). De line-up wordt binnenkort bekendgemaakt.",
  image: ["https://herderrock.be/visuals/herderrock-2026-foto-tijs-vanneste.webp"],
  eventStatus: "https://schema.org/EventScheduled", eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place", name: "Festivalweide Lambrecht",
    address: { "@type": "PostalAddress", streetAddress: "Broekstraat", addressLocality: "Herdersem (Aalst)", addressCountry: "BE" },
  },
  organizer: { "@type": "Organization", "@id": "https://herderrock.be/#organization", name: "VZW Herderrock", url: "https://herderrock.be/" },
};
---
<Layout title="Herderrock 2027 | 4 september | Festival in Herdersem"
  description={description} canonicalPath="/" image="/visuals/aftermovie-2026-desktop.webp"
  imageAlt="De festivalweide en het verlichte podium van Herderrock 2026" showHero={false}
  immersive={true} jsonLd={[pageJsonLd, nextEditionJsonLd]}>
  <main id="main-content">
    <section id="aftermovie" class="film-section" aria-label="Herderrock 2026 aftermovie">
      <div class="film-stage">
        <div class="film-darkness" aria-hidden="true"></div>
        <div class="film-frame">
          <picture class="film-poster" aria-hidden="true">
            <source media="(max-width: 767px)" srcset="/visuals/aftermovie-2026-mobile.webp" />
            <img src="/visuals/aftermovie-2026-desktop.webp" alt="" width="1600" height="900" fetchpriority="high" />
          </picture>
          <video id="aftermovie-video" playsinline muted loop preload="none" disablepictureinpicture disableRemotePlayback
            aria-label="Officiële aftermovie Herderrock 2026, door emvlstudio">
            <source media="(max-width: 767px)" src="/videos/2026/aftermovie-mobile-cut.webm" type='video/webm; codecs="vp9"' />
            <source media="(max-width: 767px)" src="/videos/2026/aftermovie-mobile-cut.mp4" type="video/mp4" />
            <source src="/videos/2026/aftermovie-desktop-cut.webm" type='video/webm; codecs="vp9"' />
            <source src="/videos/2026/aftermovie-desktop-cut.mp4" type="video/mp4" />
            Je browser ondersteunt deze video niet. <a href="/videos/2026/aftermovie-desktop-cut.mp4">Open de aftermovie.</a>
          </video>
        </div>
        <div class="film-footnote"><span class="film-byline"><a class="film-credit media-credit" href="https://www.instagram.com/emvlstudio/" target="_blank" rel="noopener noreferrer" aria-label="@emvlstudio op Instagram">@emvlstudio</a></span><a href="#herbeleef">Scroll & herbeleef <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v17m-6-6 6 6 6-6"/></svg></a></div>
        <p class="film-error" hidden>De video kan niet worden afgespeeld. <a href="/videos/2026/aftermovie-desktop-cut.mp4">Open de aftermovie apart.</a></p>
      </div>
    </section>
    <section id="herbeleef" class="memory-section">
      <div class="memory-heading">
        <h1>Dit was<br /><span>Herderrock</span><br />2026.</h1>
      </div>
      <div class="memory-strip">
        <figure><img src="/visuals/herderrock-2026-foto-publiek.webp" width="1200" height="800" alt="Festivalpubliek aan de dranghekken tijdens Herderrock 2026" loading="lazy" decoding="async" /><figcaption>Vooraan. Zoals het hoort.</figcaption></figure>
        <figure><img src="/visuals/herderrock-2026-foto-poeslief.webp" width="1200" height="800" alt="Zanger van Poeslief geeft alles op het podium van Herderrock 2026" loading="lazy" decoding="async" /><figcaption>Alles geven.</figcaption></figure>
        <figure><img src="/visuals/herderrock-2026-foto-sfeer.webp" width="1200" height="800" alt="Festivalbezoekers praten bij met een drankje op Herderrock 2026" loading="lazy" decoding="async" /><figcaption>Nog eentje dan.</figcaption></figure>
      </div>
      <p class="stills-credit">Foto’s: Emiel Viellefont / <a class="media-credit" href="https://www.instagram.com/emvlstudio/" target="_blank" rel="noopener noreferrer" aria-label="@emvlstudio op Instagram">@emvlstudio</a></p>
    </section>
    <section id="about" class="about-section">
      <div class="about-copy">
        <h2>Herderrock is een cosy muziekfestival in Herdersem (Aalst) sinds 1985</h2>
        <p>Wat startte als een projectje in de tuin van het plaatselijke jeugdhuis, is ondertussen reeds uitgegroeid tot een klassieker in de streek.</p>
        <p>Elk jaar streven we naar een cosy ervaring voor jong en al iets ouder, met de nadruk op lokaal talent maar ook de Belgische rising stars in de rockwereld komen aan bod.</p>
        <p>Op zaterdag <strong><time datetime="2027-09-04">4 september 2027</time></strong> zien we je terug op Festivalweide Lambrecht in de Broekstraat in Herdersem (Aalst). De nieuwe line-up maken we binnenkort bekend.</p>
        <a class="text-link" href="/affiches/">Duik in ons affichearchief <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
      </div>
      <div class="about-story">
        <figure class="about-photo">
          <img src="/visuals/herderrock-2026-foto-tijs-vanneste.webp" width="1400" height="935" alt="Publiek bij het verlichte podium tijdens het optreden van Tijs Vanneste op Herderrock 2026" loading="lazy" decoding="async" />
          <figcaption><span>Herderrock 2026</span><a class="media-credit"  target="_blank" rel="noopener noreferrer"></a></figcaption>
        </figure>
      </div>
    </section>
    <section id="line-up" class="secret-section">
      <div class="secret-copy"><h2>Wie er straks<br />op ons podium staat?</h2><p>De volgende line-up komt binnenkort.</p><a class="text-link" href="/faq/">Meer over Herderrock <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></div>
      <div class="secret-poster" aria-label="De volgende line-up: coming soon">
        <span class="poster-title">LINE-UP</span>
        <div class="redacted-names" aria-hidden="true"><span></span><span></span><span></span></div>
        <button class="secret-seal" type="button" aria-controls="secret-message" aria-expanded="false">COMING SOON</button>
        <p id="secret-message" aria-live="polite">De namen volgen binnenkort.</p>
        <span class="poster-bottom"><time datetime="2027-09-04">4 SEPTEMBER 2027</time></span>
      </div>
    </section>
    <div class="partners"><VIPSponsors title="Ontdek onze sponsors" titleHref="/sponsors/" /></div>
  </main>
</Layout>
<style>
  main { background: var(--red); }
  h1, h2, .poster-title, .secret-seal { font-family: var(--display-font); font-weight: 400; text-transform: uppercase; }
  svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
  .film-section { --reveal: 0; position: relative; height: 145svh; color: var(--white); }
  .film-stage { height: 100svh; position: sticky; top: 0; }
  .film-darkness { position: absolute; inset: 0; background: var(--black); opacity: calc(1 - var(--reveal)); pointer-events: none; }
  .film-frame { position: absolute; inset: 0; background: var(--black); overflow: hidden; transform: scale(calc(1 - var(--reveal) * .085)) rotate(calc(var(--reveal) * -1deg)); transform-origin: center; }
  .film-poster, .film-poster img, video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  video { display: block; opacity: 0; transition: opacity .2s ease-out; }
  video[data-playing="true"] { opacity: 1; }
  .film-footnote { position: absolute; bottom: 0; left: 0; right: 0; padding: 20px 3.5vw; background: linear-gradient(to top, #11110ef2, #11110e00); display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 66px; font-size: .68rem; font-weight: 700; letter-spacing: .08em; }
  .film-footnote > a { display: flex; align-items: center; gap: 12px; min-height: 44px; }
  .film-byline { display: flex; align-items: center; gap: 12px; }
  .media-credit { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; text-underline-offset: .22em; }
  .film-section[data-revealed="true"] .film-footnote { background: var(--red); color: #000; }
  .film-credit { font-weight: 400; letter-spacing: 0; }
  .film-error { position: absolute; bottom: 85px; left: 5%; right: 5%; padding: 14px; background: var(--black); line-height: 1.5; }
  .film-error a { text-decoration: underline; }
  .memory-section { padding: 70px 6vw 64px; color: var(--white); scroll-margin-top: 100px; }
  .memory-heading { display: flex; flex-direction: column; align-items: center; gap: 32px; max-width: 1400px; margin: 0 auto 70px; text-align: center; }
  h1 { font-size: clamp(4rem, 10vw, 8rem); line-height: .94; letter-spacing: -.025em; }
  h1 span { color: var(--black); }
  .text-link { display: inline-flex; align-items: center; gap: 18px; min-height: 44px; padding: 10px 0; margin-top: 24px; font-size: .85rem; font-weight: 700; border-bottom: 1px solid currentColor; }
  .text-link:hover svg { transform: translateX(4px); }
  .text-link svg { transition: transform .2s ease-out; }
  .memory-strip { display: grid; grid-template-columns: 1fr 1.1fr 1fr; gap: 22px; max-width: 1400px; margin: 0 auto; align-items: start; }
  .memory-strip figure { margin: 0; background: var(--white); color: var(--black); padding: 10px 10px 0; }
  .memory-strip figure:first-child { transform: rotate(-3deg); }
  .memory-strip figure:nth-child(2) { transform: translateY(28px) rotate(2deg); }
  .memory-strip figure:last-child { transform: rotate(-2deg); }
  .memory-strip figure img { display: block; width: 100%; height: auto; aspect-ratio: 1.45; object-fit: cover; }
  .memory-strip figure:nth-child(2) img { object-position: 58% center; }
  .memory-strip figcaption { padding: 14px 5px 16px; font-size: .75rem; font-weight: 700; }
  .stills-credit { color: #000; text-align: right; font-size: .7rem; margin-top: 64px; }
  .about-section { background: var(--white); padding: 110px 7vw; display: grid; grid-template-columns: 1.2fr 1fr; gap: 6vw; scroll-margin-top: 100px; }
  .about-section h2 { font-size: clamp(2.5rem, 4vw, 3.5rem); line-height: 1.02; letter-spacing: -.015em; margin-bottom: 28px; text-wrap: balance; }
  .about-story { align-self: center; }
  .about-photo { position: relative; max-width: 520px; margin: 0 12px 0 4px; padding: 10px 10px 0; background: var(--primary-gray); color: var(--white); transform: rotate(-2deg); }
  .about-photo::before { content: ""; position: absolute; top: -12px; left: calc(50% - 42px); width: 84px; height: 26px; background: var(--red); transform: rotate(-8deg); }
  .about-photo img { display: block; width: 100%; height: auto; aspect-ratio: 1.5; object-fit: cover; object-position: center 70%; }
  .about-photo figcaption { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 4px 5px; font-size: .7rem; }
  .about-photo figcaption > span { font-weight: 700; }
  .about-copy { align-self: center; max-width: 640px; font-size: 1.25rem; line-height: 1.75; }
  .about-copy p + p { margin-top: 24px; }
  .about-copy strong { color: #c4161d; }
  .secret-section { background: var(--primary-gray); color: var(--white); padding: 100px 9vw; display: grid; grid-template-columns: 1.3fr 1fr; gap: 10vw; align-items: center; scroll-margin-top: 100px; }
  .secret-copy h2 { font-size: clamp(2.5rem, 4.7vw, 4.5rem); line-height: 1.04; max-width: 620px; }
  .secret-copy p { font-size: 1rem; line-height: 1.75; margin-top: 26px; }
  .secret-poster { background: var(--white); color: var(--primary-gray); padding: 32px 28px 24px; text-align: center; transform: rotate(3deg); position: relative; max-width: 370px; width: 100%; justify-self: center; }
  .poster-title { font-size: 4rem; line-height: 1; }
  .redacted-names { display: flex; align-items: center; flex-direction: column; gap: 15px; margin: 28px 0 26px; }
  .redacted-names span { display: block; background: var(--primary-gray); height: 21px; width: 90%; }
  .redacted-names span:nth-child(2) { width: 72%; }
  .redacted-names span:last-child { width: 82%; }
  .secret-seal { position: absolute; top: 47%; left: -5%; width: 110%; background: var(--red); color: var(--white); border: 0; padding: 15px; font-size: 2.15rem; line-height: 1; transform: rotate(-10deg); cursor: pointer; transition: transform .2s ease-out; }
  .secret-seal:hover { transform: rotate(-7deg); }
  .secret-seal:focus-visible { outline-color: var(--primary-gray); }
  #secret-message { font-size: .8rem; line-height: 1.5; min-height: 44px; display: grid; place-items: center; }
  .poster-bottom { display: block; font-size: .6rem; letter-spacing: .15em; margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--primary-gray); }
  .partners { background: var(--white); padding: 45px 0; }
  @media (max-width: 767px) {
    .film-section { height: 135svh; }
    .film-footnote { padding: 22px 18px max(18px, env(safe-area-inset-bottom)); min-height: 58px; font-size: .65rem; letter-spacing: .02em; }
    .film-footnote > a { gap: 6px; }
    .film-footnote svg { width: 17px; }
    .film-byline { flex-direction: column; align-items: flex-start; gap: 0; }
    .memory-section { padding: 42px 24px 40px; }
    .memory-heading { gap: 24px; margin-bottom: 40px; }
    h1 { font-size: clamp(2.8rem, 14vw, 5.25rem); }
    .memory-strip { grid-template-columns: 1fr 1fr; gap: 14px; }
    .memory-strip figure { padding: 6px 6px 0; }
    .memory-strip figure:nth-child(2) { transform: translateY(32px) rotate(3deg); }
    .memory-strip figure:last-child { display: none; }
    .memory-strip figure img { aspect-ratio: .95; }
    .memory-strip figcaption { padding: 11px 3px 13px; font-size: .64rem; }
    .stills-credit { font-size: .6rem; margin-top: 56px; }
    .about-section { padding: 64px 24px; grid-template-columns: 1fr; gap: 40px; }
    .about-photo { margin: 0 6px; }
    .about-photo figcaption { font-size: .62rem; }
    .about-section h2 { font-size: clamp(2.1rem, 8.7vw, 3.5rem); }
    .about-copy { font-size: 1.125rem; }
    .secret-section { padding: 64px 24px 72px; grid-template-columns: 1fr; gap: 52px; }
    .secret-copy h2 { font-size: clamp(2.45rem, 9.4vw, 4rem); }
    .secret-poster { width: 84%; padding: 28px 20px 20px; }
    .poster-title { font-size: 3.5rem; }
    .secret-seal { font-size: 1.9rem; }
    .partners { padding: 20px 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .film-section { height: 100svh; }
    .film-frame { transform: none; }
    .film-darkness { opacity: 1; }
    .text-link svg, .secret-seal { transition: none; }
  }
</style>
<script>
  const film = document.querySelector<HTMLVideoElement>("#aftermovie-video");
  const section = document.querySelector<HTMLElement>(".film-section");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (film && section) {
    const error = document.querySelector<HTMLElement>(".film-error")!;
    const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const mobileFilm = window.matchMedia("(max-width: 767px)");
    const supportsWebM = Boolean(film.canPlayType('video/webm; codecs="vp9"'));
    const sourceForViewport = (format = supportsWebM ? "webm" : "mp4") =>
      `/videos/2026/aftermovie-${mobileFilm.matches ? "mobile" : "desktop"}-cut.${format}`;
    let isVisible = false;
    let hasStarted = false;
    let playPending = false;
    film.muted = true;
    film.src = sourceForViewport();
    const hasStartupBuffer = () => {
      for (let i = 0; i < film.buffered.length; i++) {
        if (film.buffered.start(i) <= film.currentTime && film.buffered.end(i) > film.currentTime) {
          const remaining = film.duration - film.currentTime;
          return film.buffered.end(i) - film.currentTime >= Math.min(2, remaining - .05);
        }
      }
      return false;
    };
    const maybePlay = () => {
      const usePoster = reducedMotion.matches || Boolean(connection?.saveData);
      film.hidden = usePoster;
      if (!isVisible || document.hidden || usePoster) {
        film.pause();
        return;
      }
      // Load only the selected viewport source, with room to buffer before playback.
      if (film.preload !== "auto") {
        film.preload = "auto";
        film.load();
        return;
      }
      if (film.readyState < HTMLMediaElement.HAVE_FUTURE_DATA || film.seeking || playPending || !film.paused) return;
      // Some browsers cap preloading; don't leave their poster waiting indefinitely.
      if (!hasStarted && !hasStartupBuffer() && film.networkState !== HTMLMediaElement.NETWORK_IDLE) return;
      playPending = true;
      const source = film.src;
      void film.play().catch((playError: DOMException) => {
        if (film.src === source && playError.name !== "AbortError") film.hidden = true;
      }).finally(() => {
        if (film.src === source) playPending = false;
      });
    };
    film.addEventListener("playing", () => {
      hasStarted = true;
      film.dataset.playing = "true";
    });
    for (const event of ["loadeddata", "canplay", "progress", "suspend", "seeked"]) {
      film.addEventListener(event, maybePlay);
    }
    const changeSource = (source: string) => {
      const time = film.currentTime;
      film.pause();
      hasStarted = false;
      playPending = false;
      delete film.dataset.playing;
      film.preload = "none";
      film.onloadedmetadata = () => {
        if (time > 0) film.currentTime = Math.min(time, Math.max(0, film.duration - .05));
        maybePlay();
      };
      film.src = source;
      maybePlay();
    };
    mobileFilm.addEventListener("change", () => {
      error.hidden = true;
      changeSource(sourceForViewport());
    });
    const showError = () => {
      if (film.src.endsWith(".webm")) {
        changeSource(sourceForViewport("mp4"));
      } else {
        error.hidden = false;
        film.hidden = true;
      }
    };
    film.addEventListener("error", showError);
    new IntersectionObserver(([entry]) => {
      isVisible = entry.isIntersecting && entry.intersectionRect.width > 0 && entry.intersectionRect.height > 0;
      maybePlay();
    }, { threshold: 0 }).observe(film.parentElement!);
    document.addEventListener("visibilitychange", maybePlay);
    reducedMotion.addEventListener("change", maybePlay);
    let queued = false;
    const updateScroll = () => {
      const reveal = reducedMotion.matches ? 0 : Math.min(1, Math.max(0, -section.getBoundingClientRect().top / (window.innerHeight * .45)));
      section.style.setProperty("--reveal", reveal.toFixed(3));
      section.dataset.revealed = String(reveal >= .5);
      queued = false;
    };
    window.addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(updateScroll); } }, { passive: true });
    window.addEventListener("resize", updateScroll);
    updateScroll();
  }
  const seal = document.querySelector<HTMLButtonElement>(".secret-seal");
  seal?.addEventListener("click", () => {
    const opened = seal.getAttribute("aria-expanded") === "true";
    seal.setAttribute("aria-expanded", String(!opened));
    document.querySelector("#secret-message")!.textContent = opened ? "De namen volgen binnenkort." : "Nog even geduld. We maken de namen binnenkort bekend!";
  });
</script>
