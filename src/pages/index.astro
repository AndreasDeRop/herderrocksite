---
import Layout from "../layouts/Layout.astro";
import VIPSponsors from "../components/VIPSponsors.astro";
import {
  eventSchedule,
  lineupActs,
  scheduleTicks,
} from "../data/lineup";

const lineupCardOrder = [
  "poeslief",
  "sustain",
  "ginos-eyeball",
  "tijs-vanneste-tangled-horns",
  "customs",
  "dnsbr",
  "fradri",
  "dibbs",
];

const lineupCards = [...lineupActs].sort(
  (a, b) => lineupCardOrder.indexOf(a.slug) - lineupCardOrder.indexOf(b.slug),
);
const timetableActs = [...lineupActs].sort(
  (a, b) => a.schedule.startMinute - b.schedule.startMinute,
);

const eventDescription = "Herderrock 2026 is een muziekfestival in Herdersem (Aalst) op zaterdag 5 september 2026 met Customs, Tijs Vanneste & Tangled Horns en lokaal talent.";
const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicEvent",
  name: "Herderrock 2026",
  description: eventDescription,
  startDate: "2026-09-05T15:30:00+02:00",
  endDate: "2026-09-06T04:00:00+02:00",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  url: "https://herderrock.be/",
  image: ["https://herderrock.be/visuals/banner-main.webp"],
  location: {
    "@type": "Place",
    name: "Festivalweide Lambrecht",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Broekstraat",
      addressLocality: "Herdersem",
      postalCode: "9310",
      addressRegion: "Aalst",
      addressCountry: "BE",
    },
  },
  organizer: {
    "@type": "Organization",
    name: "VZW Herderrock",
    url: "https://herderrock.be/",
  },
  offers: {
    "@type": "Offer",
    url: "https://herderrock.eventsquare.store/",
    availability: "https://schema.org/InStock",
  },
  performer: lineupActs.map((act) => ({
    "@type": "MusicGroup",
    name: act.name,
  })),
  subEvent: timetableActs.map((act) => ({
    "@type": "MusicEvent",
    name: `${act.name} op Herderrock 2026`,
    startDate: act.schedule.startIso,
    endDate: act.schedule.endIso,
    performer: {
      "@type": "MusicGroup",
      name: act.name,
    },
  })),
};
---

<Layout
  title="Herderrock 2026 | Muziekfestival in Herdersem (Aalst)"
  description={eventDescription}
  canonicalPath="/"
  image="/visuals/banner-main.webp"
  imageAlt="Herderrock 2026 muziekfestival in Herdersem Aalst"
  jsonLd={eventJsonLd}
>
  <main>
    <h1 class="sr-only">Herderrock 2026 - muziekfestival in Herdersem (Aalst)</h1>
    <section class="featured-band padding-top">
      <div class="featured-band-shell padding-x padding-y">
        <div class="featured-band-card featured-band-card-news">
          <div class="featured-band-content">
            <span class="featured-band-kicker">Nieuws</span>
            <h2>De timetable is er!</h2>
            <p class="featured-band-lead">
              Het volledige uurrooster voor Herderrock 2026 staat online.
            </p>
            <p>
              Scroll door de dag, volg de live tijdlijn en klik door naar elke
              band voor extra info.
            </p>
            <div class="featured-band-links">
              <a href="#timetable">Bekijk timetable</a>
              <a href="#line-up">Bekijk line-up</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="about padding-y">
      <article class="about-left padding-x">
        <p>Herderrock is een cosy muziekfestival in Herdersem (Aalst) sinds 1985</p>
        <p>
          Wat startte als een projectje in de tuin van het plaatselijke
          jeugdhuis, is ondertussen reeds uitgegroeid tot een klassieker in de
          streek.
        </p>
        <p>
          Elk jaar streven we naar een cosy ervaring voor jong en al iets ouder,
          met de nadruk op lokaal talent maar ook de Belgische rising stars in
          de rockwereld komen aan bod.
        </p>
        <p id="mb">
          Dit jaar vieren we onze 41ste editie op zaterdag <strong>5 september 2026</strong>
          op Festivalweide Lambrecht in de Broekstraat in Herdersem (Aalst), met een
          spectaculaire affiche.
        </p>
      </article>

      <div class="aftermovie-video-wrap">
        <video
          controls
          preload="metadata"
          playsinline
          muted
          poster="/visuals/aftermovie-poster.webp"
          class="aftermovie-video"
        >
          <source src="/videos/aftermovie.webm" type="video/webm" />
          <source src="/videos/aftermovie.mp4" type="video/mp4" />
          Je browser ondersteunt deze video niet.
        </video>
      </div>
    </section>

    <section id="line-up" class="lineup-section padding-y">
      <div class="lineup-shell padding-x">
        <div class="lineup-top">
          <div class="lineup-intro">
            <h2>De lineup is er!</h2>
            <p>
              <strong>Customs</strong> staat vast als headliner voor Herderrock 2026,
              het muziekfestival in Aalst voor rock, lokaal talent en Belgische bands,
              met onder meer <strong>Tijs Vanneste & Tangled Horns</strong>,
              <strong>DNSBR</strong>, <strong>SUSTAIN</strong>, <strong>Poeslief</strong>
              en onze DJ's op de affiche.
            </p>
          </div>

          <div class="lineup-stamp">
            <span class="lineup-stamp-label">Herderrock 2026</span>
            <strong>LINE-UP</strong>
          </div>
        </div>

        <div class="lineup-grid">
          {lineupCards.map((act) => (
            <a
              class="lineup-card lineup-card-confirmed"
              href={`/bands/${act.slug}/`}
              aria-label={`Meer info over ${act.name}`}
            >
              <div class="lineup-card-image">
                <img src={act.image} alt={act.alt} loading="lazy" decoding="async" />
                <span class="lineup-card-image-arrow" aria-hidden="true">&#8599;</span>
              </div>
              <div class="lineup-card-body">
                <span class={`lineup-card-name ${act.nameClass ?? ""}`}>
                  {act.cardName ?? act.name}
                </span>
                <span class="lineup-card-meta">{act.meta}</span>
                <span class="lineup-card-time">{act.schedule.label}</span>
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>

    <section id="timetable" class="timetable-section padding-y">
      <div class="timetable-shell padding-x">
        <div class="timetable-top">
          <div>
            <span class="timetable-kicker">{eventSchedule.dateLabel}</span>
            <h2>Timetable</h2>
          </div>

          <div class="timetable-live-panel">
            <span class="timetable-doors">{eventSchedule.doorsLabel}</span>
            <span class="timetable-status" data-schedule-status>Live vanaf 16:00</span>
            <button class="timetable-now-button" type="button" data-scroll-now>
              Naar nu
            </button>
          </div>
        </div>

        <div
          class="timetable-board"
          data-schedule
          data-start={eventSchedule.startIso}
          data-end={eventSchedule.endIso}
          data-total-minutes={eventSchedule.totalMinutes}
          style={`--total-minutes: ${eventSchedule.totalMinutes};`}
        >
          <div class="timetable-scroll" data-schedule-scroll>
            <div class="timetable-grid">
              {scheduleTicks.map((tick) => (
                <div class="timetable-tick" style={`--tick-minute: ${tick.minute};`}>
                  <span>{tick.label}</span>
                </div>
              ))}

              {timetableActs.map((act) => (
                <a
                  class={`timetable-act ${
                    act.meta === "Headliner" ? "timetable-act-headliner" : ""
                  }`}
                  href={`/bands/${act.slug}/?from=timetable`}
                  style={`--act-start: ${act.schedule.startMinute}; --act-duration: ${act.schedule.duration};`}
                  data-act-start={act.schedule.startIso}
                  data-act-end={act.schedule.endIso}
                >
                  <span class="timetable-act-time">{act.schedule.label}</span>
                  <strong>{act.name}</strong>
                  <span class="timetable-act-action">
                    <span class="timetable-act-meta">{act.scheduleMeta ?? act.meta}</span>
                    <span class="timetable-act-arrow" aria-hidden="true">&#8599;</span>
                  </span>
                </a>
              ))}

              <div class="timetable-now-line" data-now-line hidden>
                <span>Nu</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <VIPSponsors />
  </main>
</Layout>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  main {
    width: 100%;
  }

  .button {
    padding: 12px 16px;
    background-color: var(--red);
    color: var(--white);
    text-decoration: none;
    font-weight: bold;
    text-align: center;
    border: 2px dashed var(--red);
  }

  #tshirt {
    background-color: var(--white);
    color: var(--red);
    border: 2px dashed var(--red);
  }

  .cta-buttons {
    display: flex;
    flex-direction: row;
    gap: 16px;
  }

  .button:hover {
    cursor: pointer;
    opacity: 0.5;
  }

  .featured-band,
  .about,
  .lineup-section,
  .timetable-section {
    background-color: var(--white);
  }

  .featured-band-shell,
  .lineup-shell,
  .timetable-shell {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .lineup-section,
  .timetable-section {
    scroll-margin-top: 96px;
  }

  .about {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: stretch;
    gap: 24px;
  }

  .about-left {
    padding: 56px 56px 56px 64px;
    color: var(--primary-gray);
    font-size: 18px;
    background-color: var(--white);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .about-left > * {
    max-width: 560px;
  }

  .about-left p {
    margin: 0 0 18px 0;
    line-height: 1.8;
  }

  .about-left p:first-child {
    font-family: "Herderrock Impact", Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--primary-gray);
    margin-bottom: 24px;
  }

  .about-left strong {
    color: var(--red);
    display: inline;
  }

  #mb {
    margin-bottom: 0;
  }

  .aftermovie-video-wrap {
    width: 100%;
    min-height: 100%;
    background-color: var(--black);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid var(--black);
  }

  .aftermovie-video {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 420px;
    max-height: 720px;
    object-fit: cover;
    background-color: var(--black);
  }

  .featured-band-card {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: stretch;
    overflow: hidden;
    background-color: var(--primary-gray);
    border: 3px solid var(--black);
  }

  .featured-band-card-news {
    grid-template-columns: 1fr;
  }

  .featured-band-visual {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--red);
    overflow: hidden;
  }

  .featured-band-mist-layer {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .featured-band-mist {
    position: absolute;
    pointer-events: none;
    opacity: 0.9;
  }

  .featured-band-mist img {
    display: block;
    width: 100%;
    height: auto;
  }

  .featured-band-mist-left {
    left: -5%;
    bottom: -5%;
    width: min(30vw, 360px);
  }

  .featured-band-mist-right {
    right: -7%;
    top: -6%;
    width: min(26vw, 320px);
  }

  .featured-band-image-frame {
    position: relative;
    z-index: 2;
    width: min(82%, 660px);
    animation: featuredFrameIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .featured-band-image-frame img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 560px;
    object-fit: contain;
    animation: featuredImageIn 1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .featured-band-content {
    padding: 56px 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--white);
    background-color: var(--primary-gray);
    animation: featuredContentIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  .featured-band-card-news .featured-band-content {
    min-height: 300px;
    padding: 48px;
  }

  .featured-band-kicker {
    display: inline-block;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.8rem;
    color: var(--white);
    opacity: 0.8;
  }

  .featured-band-content h2 {
    font-family: "Herderrock Impact", Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 0.9;
    color: var(--white);
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .featured-band-subtitle {
    display: block;
    margin-top: 8px;
    font-size: 0.56em;
    line-height: 1;
    letter-spacing: 0.08em;
  }

  .featured-band-lead {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--white);
    margin-bottom: 12px;
  }

  .featured-band-content p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--white);
    margin: 0 0 12px 0;
  }

  .featured-band-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 22px;
    width: 100%;
    max-width: 360px;
  }

  .featured-band-card-news .featured-band-links {
    flex-direction: row;
    flex-wrap: wrap;
    max-width: 360px;
  }

  .featured-band-card-news .featured-band-links a {
    width: auto;
    min-width: 170px;
  }

  .featured-band-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 14px 20px;
    border: 2px solid var(--white);
    color: var(--white);
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .featured-band-links a:hover {
    transform: translateY(-2px);
    background-color: var(--white);
    color: var(--red);
  }

  .lineup-shell {
    border: 3px solid var(--black);
    background-color: var(--primary-gray);
    padding-top: 32px;
    padding-bottom: 32px;
    position: relative;
    overflow: hidden;
  }

  .lineup-shell::before,
  .lineup-shell::after {
    content: "";
    position: absolute;
    pointer-events: none;
    z-index: 1;
  }

  .lineup-shell::before {
    left: -2%;
    bottom: -2%;
    width: min(18vw, 200px);
    aspect-ratio: 1;
    background: url("/visuals/mist-1.webp") no-repeat center / contain;
    opacity: 0.9;
  }

  .lineup-shell::after {
    right: -2%;
    top: -2%;
    width: min(18vw, 200px);
    aspect-ratio: 1;
    background: url("/visuals/mist-4.webp") no-repeat center / contain;
    opacity: 0.9;
  }

  .lineup-top,
  .lineup-grid {
    position: relative;
    z-index: 2;
  }

  .lineup-top {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 24px;
    align-items: start;
    margin-bottom: 28px;
  }

  .lineup-intro {
    color: var(--white);
  }

  .lineup-kicker {
    display: inline-block;
    margin-bottom: 14px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.8rem;
    opacity: 0.8;
  }

  .lineup-intro h2 {
    font-family: "Herderrock Impact", Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(2.6rem, 5vw, 4.8rem);
    line-height: 0.92;
    margin: 0 0 18px 0;
    color: var(--white);
  }

  .lineup-intro p {
    margin: 0;
    max-width: 700px;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--white);
  }

  .lineup-stamp {
    border: 3px solid var(--white);
    color: var(--white);
    text-align: center;
    padding: 22px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    justify-self: end;
    width: 100%;
    max-width: 320px;
    background-color: var(--red);
  }

  .lineup-stamp-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    opacity: 0.85;
  }

  .lineup-stamp strong {
    font-family: "Herderrock Impact", Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 0.9;
    color: var(--white);
  }

  .lineup-stamp span:last-child {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .lineup-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .lineup-card {
    position: relative;
    display: block;
    border: 2px solid var(--white);
    background-color: rgba(249, 238, 213, 0.05);
    overflow: hidden;
    min-height: 100%;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .lineup-card:hover,
  .lineup-card:focus-visible {
    transform: translateY(-4px);
    background-color: rgba(249, 238, 213, 0.12);
    border-color: var(--red);
    outline: none;
  }

  .lineup-card-image {
    position: relative;
    aspect-ratio: 1 / 1;
    border-bottom: 2px solid var(--white);
    background-color: rgba(0, 0, 0, 0.16);
    overflow: hidden;
  }

  .lineup-card-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lineup-card-image-arrow {
    position: absolute;
    top: 8px;
    right: 10px;
    z-index: 2;
    color: var(--primary-gray);
    font-size: 2rem;
    font-weight: 900;
    line-height: 1;
    text-shadow:
      1px 1px 0 var(--white),
      -1px 1px 0 var(--white),
      1px -1px 0 var(--white),
      -1px -1px 0 var(--white);
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }

  .lineup-card:hover .lineup-card-image-arrow,
  .lineup-card:focus-visible .lineup-card-image-arrow {
    transform: translate(3px, -3px);
    color: var(--primary-gray);
  }

  .lineup-card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    align-items: center;
  }

  .lineup-card-name {
    width: 100%;
    font-family: "Herderrock Impact", Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(1.5rem, 2.4vw, 2.2rem);
    line-height: 0.95;
    text-align: center;
    text-transform: uppercase;
    color: var(--white);
  }

  .lineup-card-name-compact {
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    white-space: nowrap;
  }

  .lineup-card-meta {
    font-size: 0.84rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--white);
    opacity: 0.82;
  }

  .lineup-card-time {
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--white);
    background-color: var(--red);
    padding: 6px 10px;
    border: 1px solid rgba(249, 238, 213, 0.55);
  }

  .lineup-card-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    border-style: dashed;
  }

  .lineup-card-placeholder .lineup-card-body {
    min-height: 100%;
    justify-content: center;
  }

  .timetable-shell {
    background-color: var(--white);
    padding-top: 42px;
    padding-bottom: 36px;
  }

  .timetable-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: end;
    margin-bottom: 24px;
  }

  .timetable-kicker {
    display: inline-block;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--red);
  }

  .timetable-top h2 {
    font-family: "Herderrock Impact", Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--primary-gray);
  }

  .timetable-live-panel {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    color: var(--primary-gray);
  }

  .timetable-doors,
  .timetable-status {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 12px;
    border: 2px solid var(--primary-gray);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.74rem;
  }

  .timetable-status {
    color: var(--white);
    background-color: var(--primary-gray);
  }

  .timetable-now-button {
    min-height: 42px;
    padding: 0 16px;
    border: 2px solid var(--black);
    background-color: var(--red);
    color: var(--white);
    font: inherit;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .timetable-now-button:hover,
  .timetable-now-button:focus-visible {
