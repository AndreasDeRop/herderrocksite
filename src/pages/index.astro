<script>
  document.addEventListener("DOMContentLoaded", () => {
    const aftermovieWrap = document.querySelector(".aftermovie-video-wrap");
    const aftermovieVideo = document.querySelector(".aftermovie-video");

    if (aftermovieWrap instanceof HTMLDivElement && aftermovieVideo instanceof HTMLVideoElement) {
      const togglePlayback = async (isVisible: boolean) => {
        if (isVisible) {
          try {
            await aftermovieVideo.play();
          } catch (_error) {
          }
          return;
        }

        aftermovieVideo.pause();
      };

      const observer = new IntersectionObserver(
        ([entry]) => {
          togglePlayback(entry?.isIntersecting && entry.intersectionRatio >= 0.45);
        },
        {
          threshold: [0.45, 0.6],
        },
      );

      observer.observe(aftermovieWrap);

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          aftermovieVideo.pause();
        }
      });
    }

    const schedule = document.querySelector("[data-schedule]");

    if (!(schedule instanceof HTMLElement)) {
      return;
    }

    const scheduleScroll = schedule.querySelector("[data-schedule-scroll]");
    const nowLine = schedule.querySelector("[data-now-line]");
    const status = document.querySelector("[data-schedule-status]");
    const scrollNowButton = document.querySelector("[data-scroll-now]");
    const acts = Array.from(schedule.querySelectorAll("[data-act-start][data-act-end]"));
    const startTime = Date.parse(schedule.dataset.start ?? "");
    const endTime = Date.parse(schedule.dataset.end ?? "");
    const totalMinutes = Number(schedule.dataset.totalMinutes ?? 0);
    const timeFormatter = new Intl.DateTimeFormat("nl-BE", {
      hour: "2-digit",
      minute: "2-digit",
      timeZone: "Europe/Brussels",
    });

    const getMinuteHeight = () => {
      const value = window.getComputedStyle(schedule).getPropertyValue("--minute-height");
      return Number.parseFloat(value) || 3.05;
    };

    const getSchedulePadding = () => {
      const value = window.getComputedStyle(schedule).getPropertyValue("--schedule-pad-y");
      return Number.parseFloat(value) || 0;
    };

    const getCurrentTime = () => {
      const testNow = new URLSearchParams(window.location.search).get("timetableNow");
      const parsedTestNow = Date.parse((testNow ?? "").replace(" ", "+"));

      return Number.isFinite(parsedTestNow) ? parsedTestNow : Date.now();
    };

    const setStatus = (message: string) => {
      if (status instanceof HTMLElement) {
        status.textContent = message;
      }
    };

    const updateSchedule = () => {
      if (!Number.isFinite(startTime) || !Number.isFinite(endTime) || totalMinutes <= 0) {
        return false;
      }

      const now = getCurrentTime();
      const currentMinute = (now - startTime) / 60000;
      const clampedMinute = Math.min(Math.max(currentMinute, 0), totalMinutes);
      const isLive = now >= startTime && now <= endTime;

      schedule.style.setProperty("--now-offset", String(clampedMinute));

      if (nowLine instanceof HTMLElement) {
        nowLine.hidden = !isLive;
      }

      if (scrollNowButton instanceof HTMLButtonElement) {
        scrollNowButton.disabled = !isLive;
      }

      acts.forEach((act) => {
        if (!(act instanceof HTMLElement)) {
          return;
        }

        const actStart = Date.parse(act.dataset.actStart ?? "");
        const actEnd = Date.parse(act.dataset.actEnd ?? "");
        act.classList.toggle("is-active", now >= actStart && now < actEnd);
      });

      if (isLive) {
        setStatus(`Nu ${timeFormatter.format(new Date(now))}`);
        return true;
      }

      if (now < startTime) {
        setStatus("Live vanaf 16:00");
        return false;
      }

      setStatus("Afgelopen om 04:00");
      return false;
    };

    const scrollToNow = () => {
      if (!(scheduleScroll instanceof HTMLElement)) {
        return;
      }

      updateSchedule();
      const currentMinute = Number.parseFloat(
        schedule.style.getPropertyValue("--now-offset") || "0",
      );
      const targetTop = getSchedulePadding() + currentMinute * getMinuteHeight();

      scheduleScroll.scrollTo({
        top: Math.max(targetTop - scheduleScroll.clientHeight * 0.46, 0),
        behavior: "smooth",
      });
    };

    const isLiveOnLoad = updateSchedule();
    window.setInterval(updateSchedule, 30000);

    if (scrollNowButton instanceof HTMLButtonElement) {
      scrollNowButton.addEventListener("click", scrollToNow);
    }

    if (isLiveOnLoad) {
      window.setTimeout(scrollToNow, 350);
    }
  });
</script>
