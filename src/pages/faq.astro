---
import Layout from "../layouts/Layout.astro";

const faqDescription = "Herderrock vindt plaats op zaterdag 4 september 2027 in Herdersem (Aalst). Lees de praktische info. Line-up en ticketinformatie volgen later.";
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://herderrock.be/faq/#webpage",
  url: "https://herderrock.be/faq/", inLanguage: "nl-BE",
  name: "Praktische info over Herderrock 2027", description: faqDescription,
  isPartOf: { "@id": "https://herderrock.be/#website" },
  mainEntity: [
    {
      "@type": "Question",
      name: "Wat is Herderrock?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Herderrock is een muziekfestival in Herdersem (Aalst) dat georganiseerd wordt door VZW Herderrock.",
      },
    },
    {
      "@type": "Question",
      name: "Waar kan ik tickets kopen?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Herderrock 2026 is afgelopen. Ticketinformatie voor de volgende editie wordt later bekendgemaakt.",
      },
    },
    {
      "@type": "Question",
      name: "Wanneer is de volgende editie?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "De volgende editie van Herderrock vindt plaats op zaterdag 4 september 2027. De line-up en verdere praktische informatie worden later bekendgemaakt.",
      },
    },
    {
      "@type": "Question",
      name: "Waar parkeren?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Kom bij voorkeur met de fiets. Voor auto's is er geen parking op de festivalweide zelf. Parkeer enkel in de toegelaten zones en parkeer zeker niet op de toegangsweg naar de festivalweide, zodat bewoners, organisatie en hulpdiensten altijd door kunnen. Zoek je toch nog ergens een parkeerplaats? Ter hoogte van Gilbos NV kan je parkeren (zie onderstaande foto)",
      },
    },
    {
      "@type": "Question",
      name: "Hoe luid is Herderrock?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Herderrock respecteert de geluidsnormen van de Stad Aalst. We begrijpen dat het festival voor de buurt overlast kan veroorzaken en vragen bezoekers om buiten de festivalzone geen lawaai te maken dat door omwonenden als storend kan worden ervaren.",
      },
    },
    {
      "@type": "Question",
      name: "Wat te doen in geval van nood?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Volg de instructies van de organisatie, verlaat de site vlot en houd de volledige toegangsweg vrij voor hulpdiensten. Er zijn twee verzamelplaatsen voorzien bij evacuatie. Evacueer eerst en help waar nodig; filmen of posten op sociale media helpt niemand.",
      },
    },
    {
      "@type": "Question",
      name: "Kan ik het terrein van editie 2026 bekijken?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ja. Het 3D-terreinplan van editie 2026 blijft beschikbaar als terugblik. Het plan voor een volgende editie kan afwijken.",
      },
    },
  ],
};
---

<Layout
  title="Herderrock FAQ | 4 september 2027 in Herdersem"
  description={faqDescription}
  canonicalPath="/faq/"
  image="/visuals/aftermovie-2026-desktop.webp"
  imageAlt="Praktische info voor Herderrock muziekfestival in Aalst"
  jsonLd={faqJsonLd}
>
  <main id="main-content" class="margin-top">
    <h1 class="title title-left">Praktische info</h1>
    <p class="edition-note">De volgende editie van Herderrock is op zaterdag <time datetime="2027-09-04">4 september 2027</time>. De line-up komt binnenkort. Onderstaande terrein- en bezoekersinformatie hoort bij editie 2026; verdere informatie voor 2027 volgt later.</p>
    <section class="faq padding-y padding-x">
      <div class="faq-item">
        <button class="faq-question">
          <h3>Wat is Herderrock?</h3>
          <span class="icon">+</span>
        </button>
        <div class="faq-answer">
          <p>
            Herderrock is een muziekfestival in Herdersem (Aalst) dat
            georganiseerd wordt door de VZW Herderrock.
          </p>
          <p>
            Wat startte als een projectje in de tuin van het plaatselijke
            jeugdhuis, is ondertussen reeds uitgegroeid tot een klassieker in de
            streek.
          </p>
          <p>
            Elk jaar streven we naar een gezellige ervaring voor jong en iets
            ouder, met de nadruk op lokaal talent. Maar ook Belgische 'rising
            stars' in de rockwereld krijgen een plaats op het podium.
          </p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <h3>Waar parkeren?</h3>
          <span class="icon">+</span>
        </button>
        <div class="faq-answer">
          <p>
            We moedigen iedereen aan om met de fiets naar het festival te komen.
            Er zijn voldoende fietsenstallingen voorzien waar je je stalen ros
            veilig kunt parkeren.
          </p>
          <p>
            Voor auto's is er GEEN parkeergelegenheid op de festivalweide zelf.
            Bezoekers kunnen parkeren in de omliggende straten. We vragen wel om rekening te houden met de buurt: respecteer de
            rust en laat geen afval achter. Zoek je toch nog een parkeerplaats? Je kan ook parkeren ter hoogte van Gilbos NV (zie onderstaande foto)
          </p>
          <p>
            <strong>Belangrijk:</strong> parkeer zeker niet op de toegangsweg naar
            de festivalweide. Die weg moet altijd vrij blijven voor bewoners,
            organisatie en hulpdiensten. Parkeer dus enkel in de toegelaten zones.
          </p>
          <figure class="faq-media">
            <img
              src="/visuals/parking-route-herderrock.webp"
              alt="Route en parkeerinfo voor Herderrock"
              loading="lazy"
              decoding="async"
              width="1294"
              height="602"
            />
          </figure>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <h3>Wat is de prijs van een ticket?</h3>
          <span class="icon">+</span>
        </button>
        <div class="faq-answer">
          <p>
            De ticketprijzen voor de volgende editie worden later bekendgemaakt.
          </p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <h3>Waar kan ik mijn ticket kopen?</h3>
          <span class="icon">+</span>
        </button>
        <div class="faq-answer">
          <p>
            Herderrock 2026 is afgelopen. Zodra er nieuws is over tickets voor de volgende editie, vind je dat op deze website. Koop altijd via de officiële kanalen van Herderrock.
          </p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <h3>Wanneer is de volgende editie?</h3>
          <span class="icon">+</span>
        </button>
        <div class="faq-answer">
          <p>
            De volgende editie van Herderrock vindt plaats op zaterdag <time datetime="2027-09-04">4 september 2027</time>. De line-up en verdere praktische informatie worden later bekendgemaakt.
          </p>
        </div>
      </div>
      <div class="faq-item faq-item-terrain">
        <button class="faq-question">
          <h3>Kan ik het terrein van editie 2026 bekijken?</h3>
          <span class="icon">+</span>
        </button>
        <div class="faq-answer">
          <p>
            Bekijk hieronder het terreinplan van editie 2026. Dit blijft beschikbaar als terugblik; het plan voor een volgende editie kan afwijken.
          </p>

          <div class="terrain-viewer">
            <model-viewer
              src="/models/hk2026.glb"
              poster="/models/hk2026-poster.png"
              alt="3D terreinplan van Herderrock 2026"
              camera-controls
              touch-action="none"
              loading="lazy"
              reveal="auto"
              interaction-prompt="none"
              camera-target="-35m 0m 62m"
              camera-orbit="0deg 0deg 135m"
              field-of-view="55deg"
              min-camera-orbit="auto auto 55m"
              max-camera-orbit="auto auto 260m"
              shadow-intensity="0.35"
              exposure="0.9"
              environment-image="neutral"
            ></model-viewer>
          </div>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <h3>Is herderrock toegankelijk voor mensen met een handicap?</h3>
          <span class="icon">+</span>
        </button>
        <div class="faq-answer">
          <p>
            Iedereen is van harte welkom op ons festival, ook bezoekers die
            gebruikmaken van een rolstoel. Onze festivalweide is in principe
            goed bereikbaar, maar houd er rekening mee dat het - zeker bij nat
            weer - soms praktischer kan zijn om een assistent mee te brengen.
            Daarnaast voorzien wij een comfortabele zithoek op de weide. Indien
            u ten minste één dag vóór het evenement een aanvraag indient via
            onze Facebookpagina, kunnen wij extra stoelen voor u reserveren.
          </p>
          <small
            >* Let op: de assistent dient ook in het bezit te zijn van een
            toegangsticket. Dit om misbruik te voorkomen.
          </small>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <h3>Hoe kan ik betalen op het festivalterrein?</h3>
          <span class="icon">+</span>
        </button>
        <div class="faq-answer">
          <p>
            Wij voorzien 2 betalingsmethodes:<br />
            Cash is king!
            Maar je kan ook contactloos betalen met je credit- of debetkaart.
          </p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <h3>Wat mag ik meebrengen naar Herderrock?</h3>
          <span class="icon">+</span>
        </button>
        <div class="faq-answer">
          <p>
            Een rugzak, om bijvoorbeeld je herderrock merch in weg te bergen,
            deze kan wel gecontroleerd worden.<br />
            Wij zijn niet per se tegen huisdieren op de weide, maar weet wel dat
            de muziek voor huisdieren als luid kan worden ervaren. Wij respecteren
            natuurlijk de geluidsnormen, maar onze viervoeters hebben een beter gehoor
            dan de gemiddelde mens.
          </p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <h3>
            Wat mag ik zeker <strong>NIET</strong> meebrengen naar Herderrock?
          </h3>
          <span class="icon">+</span>
        </button>
        <div class="faq-answer">
          <p>
            Wij verkopen zelf drank en eten, dit festival is enkel mogelijk
            dankzij deze verkoop. Daarom worden eigen dranken en eten niet
            toegelaten op de festivalweide. Voor de mensen die een grote
            hoeveelheid drank willen drinken, hebben we een speciale zone
            genaamd "Den Tetterbar"<br />
            Alle soorten vuurwerk zijn verboden op het festivalterrein.<br />
            Het is ten strengste verboden om op het festivalterrein drugs bij te
            hebben, te verkopen of te gebruiken.<br />
            Het is verboden om scherpe voorwerpen zoals messen, scharen en glas mee
            te nemen naar het festivalterrein.
          </p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <h3>Hoe luid is herderrock?</h3>
          <span class="icon">+</span>
        </button>
        <div class="faq-answer">
          <p>
            Wij volgen de regels zoals deze ons zijn opgelegd door de bevoegde
            diensten van de Stad Aalst. Hierbij respecteren wij de geluidsnorm
            van 95dB tot 1u 's nachts, nadien tot 4u 's nachts geldt 90dB als
            maximum en volgen wij die uiteraard ook op.<br />
            Wij hebben ook oordopjes ter beschikking die gratis kunnen worden opgehaald
            aan de toog. Daarnaast is het ook toegestaan om je eigen aangepaste gehoorsbescherming
            mee te nemen.
          </p>
          <p>
            We begrijpen dat dit voor de buurt overlast kan veroorzaken. Daarom
            vragen we om die overlast niet groter te maken: maak buiten de
            festivalzone geen lawaai dat door omwonenden als storend kan worden
            ervaren.
          </p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <h3>Wat te doen in geval van nood?</h3>
          <span class="icon">+</span>
        </button>
        <div class="faq-answer">
          <p>
            We hebben als organisatie een noodplan opgesteld. In geval van nood
            zal dit plan in werking worden gesteld en zal de organisatie de
            mensen ter plaatse inlichten. Het belangrijkste is dat je jezelf en
            je gezinsleden veilig houdt, en vooral niet begint te panikeren.
          </p>
          <p>
            Er zijn twee verzamelplaatsen voorzien bij evacuatie. Verlaat de site
            zo snel en vlot mogelijk en houd de volledige toegangsweg vrij, zodat
            de hulpdiensten snel kunnen ingrijpen. Er mag dus enkel geparkeerd
            worden in de toegelaten zones.
          </p>
          <p>
            We vragen ook om eerst te evacueren en waar mogelijk mensen te helpen,
            in plaats van te filmen of te posten op sociale media. Iemand helpen
            is niet hetzelfde als iemand filmen.
          </p>
          <figure class="faq-media">
            <img
              src="/visuals/nooduitgangen-herderrock.webp"
              alt="Nooduitgangen en verzamelplaatsen bij Herderrock"
              loading="lazy"
              decoding="async"
              width="587"
              height="333"
            />
          </figure>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <h3>Wat te doen bij slecht weer?</h3>
          <span class="icon">+</span>
        </button>
        <div class="faq-answer">
          <p>
            Herderrock gaat in principe altijd door, ook bij regen. We zijn
            immers niet van suiker. ☔ Maar bij extreem weer (zoals een
            officiële code geel, oranje of rood van het KMI), nemen we geen
            risico’s. We volgen dan de officiële adviezen op en houden altijd de
            veiligheid van onze bezoekers, crew en artiesten voorop.<br /><br />
            Wat jij zelf kan doen als bezoeker:<br />
            Check altijd het weerbericht en onze communicatie vooraf. Voorzie waterdichte
            kledij en stevige schoenen. Gebruik geen paraplu’s (die kunnen gevaarlijk zijn
            bij wind). Breng eventueel een regenponcho mee. Respecteer altijd de
            instructies van de organisatie en de veiligheidsmensen.
          </p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question">
          <h3>Hoe kan ik meer informatie over Herderrock krijgen?</h3>
          <span class="icon">+</span>
        </button>
        <div class="faq-answer">
          <p>
            Indien deze FAQ niet voldoende antwoorden geeft, kan je altijd
            contact opnemen met de organisatie via <a
              href="mailto:info@herderrock.be">info@herderrock.be</a
            >.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
.edition-note { max-width: 1200px; margin: 24px auto 0; padding: 0 5%; line-height: 1.7; }
 main {
  background-color: var(--white);
}

h1.title.title-left {
  width: auto;
  max-width: 1200px;
  margin: 0 auto;
  box-sizing: border-box;
}

.faq {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 1200px;
  margin: 0 auto;
  background-color: var(--white);
}

.faq-item {
  border: 3px solid var(--black);
  background-color: var(--primary-gray);
  overflow: hidden;
}

.faq-question {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 22px 24px;
  background: var(--primary-gray);
  border: none;
  cursor: pointer;
  text-align: left;
  color: var(--white);
}

.faq-question h3 {
  margin: 0;
  font-size: 1.2rem;
  line-height: 1.3;
  font-weight: 500;
  color: var(--white);
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition:
    max-height 0.3s ease,
    padding 0.3s ease;
  padding: 0 24px;
  background-color: var(--primary-gray);
  color: var(--white);
  border-top: 1px solid rgba(249, 238, 213, 0.2);
}

.faq-answer.active {
  max-height: 2400px;
  padding: 0 24px 24px;
}

.faq-answer p,
.faq-answer small {
  color: var(--white);
  line-height: 1.75;
}

.faq-answer a {
  color: var(--red);
  font-weight: 700;
}

.faq-answer p {
  margin: 16px 0 0;
}

.faq-answer small {
  display: block;
  margin-top: 12px;
  opacity: 0.9;
}

.faq-media {
  margin: 18px 0 0;
}

.faq-media img {
  display: block;
  width: 100%;
  height: auto;
  border: 2px solid var(--white);
  background: var(--black);
}

.icon {
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--white);
  border: 2px solid var(--white);
  transition:
    transform 0.25s ease,
    background-color 0.25s ease,
    color 0.25s ease;
}

.faq-question.active .icon {
  transform: rotate(45deg);
  background-color: var(--red);
  border-color: var(--red);
}

.faq-question:hover .icon {
  background-color: var(--red);
  border-color: var(--red);
}

.faq-question strong {
  color: var(--red);
  text-decoration: none;
}

.faq-answer strong {
  color: var(--red);
  text-decoration: none;
}
.terrain-viewer {
  margin-top: 22px;
  border: 2px solid var(--white);
  background: var(--black);
  color: var(--white);
  overflow: hidden;
  overscroll-behavior: contain;
}

.terrain-viewer model-viewer {
  display: block;
  width: 100%;
  height: min(72vh, 680px);
  min-height: 520px;
  background: var(--black);
  touch-action: none;
  user-select: none;
  -webkit-user-select: none;
  --progress-bar-color: var(--red);
  --progress-bar-height: 4px;
}

@media only screen and (max-width: 900px) {
  h1.title.title-left {
    max-width: 100%;
  }

  .faq {
    gap: 12px;
  }

  .faq-question {
    padding: 18px 18px;
    align-items: flex-start;
  }

  .faq-question h3 {
    font-size: 1.05rem;
  }

  .faq-answer {
    padding: 0 18px;
  }

  .faq-answer.active {
    padding: 0 18px 18px;
  }

  .icon {
    width: 32px;
    height: 32px;
    font-size: 1.2rem;
  }
  .terrain-viewer model-viewer {
    height: 62vh;
    min-height: 360px;
  }
}
</style>

<script is:inline type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.1.0/model-viewer.min.js"></script>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const faqQuestions = document.querySelectorAll(".faq-question");

    faqQuestions.forEach((question) => {
      question.addEventListener("click", () => {
        const answer = question.nextElementSibling;
        if (!answer) return;

        faqQuestions.forEach((q) => {
          const otherAnswer = q.nextElementSibling;
          if (q !== question && otherAnswer) {
            q.classList.remove("active");
            otherAnswer.classList.remove("active");
          }
        });

        question.classList.toggle("active");
        answer.classList.toggle("active");
      });
    });
  });
</script>
